// Lab Hub: values you must fill in before the app can run on a real iPhone.
//
// HOW TO USE
//   1. Copy this file to Config/Secrets.xcconfig (that name is gitignored, so it is never committed).
//   2. Replace every YOUR_..._HERE value below.
//   3. Run the app. If something is wrong, the log says which value and why:
//        Console.app -> filter "com.labhub.core" -> category "config"
//      (LabHubCore's AppConfig.validate checks every key in this file and never prints the token.)
//
// NOT HERE: the APNs signing key (.p8). It lives only in the vault repo's Actions secrets (ADR 0002).
// The phone never needs it.

// Apple Developer account (paid, ADR 0001).
// developer.apple.com -> Account -> Membership details -> Team ID (10 letters/digits).
APPLE_TEAM_ID = YOUR_TEAM_ID_HERE

// The app's bundle id, reverse-DNS, as registered under Certificates, Identifiers & Profiles -> Identifiers.
APP_BUNDLE_ID = YOUR_BUNDLE_ID_HERE

// App Group shared by the app and the widget (feed cache). Must start with "group.".
APP_GROUP_ID = YOUR_APP_GROUP_HERE

// Keychain group shared by the app and the widget (the GitHub token). Usually <TEAM_ID>.<BUNDLE_ID>.
KEYCHAIN_ACCESS_GROUP = YOUR_KEYCHAIN_GROUP_HERE

// Fine-grained GitHub token for tmwang7324/Obsidian-Notes. Needed permissions:
//   Contents: read          (to fetch feed.json from the feed branch)
//   Variables: read + write (so the app can store its push tokens, ADR 0002)
// Starts with github_pat_ . Create at github.com -> Settings -> Developer settings -> Fine-grained tokens.
GITHUB_TOKEN = YOUR_GITHUB_TOKEN_HERE
